page{background:#f5f8f5;color:#183c33;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}view,text,button,input{box-sizing:border-box}button{font-size:28rpx;line-height:1.5;margin:0}button::after{border:0}button[disabled]{opacity:.48}.page{padding:48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#688277}.headline{font-size:52rpx;font-weight:600;line-height:1.4;letter-spacing:-1rpx;margin:14rpx 0 20rpx}.muted{color:#647a6e}.small{font-size:24rpx}.tiny{font-size:22rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.panel{background:#fff;border:1rpx solid #e0e9e2;border-radius:32rpx;padding:30rpx;margin:24rpx 0}.primary{background:#176e54;color:#fff;border-radius:24rpx;padding:26rpx 20rpx;width:100%;min-height:92rpx;font-weight:500}.secondary{background:#fff;color:#315e4a;border:1rpx solid #d7e4da;border-radius:24rpx;padding:22rpx;width:100%;min-height:88rpx}.footer{font-size:22rpx;text-align:center;color:#6c8174;margin-top:36rpx}.tag{font-size:22rpx;background:#fff0dc;color:#905618;border-radius:12rpx;padding:6rpx 14rpx}.section-title{font-size:32rpx;font-weight:600;margin:36rpx 0 20rpx}.error{color:#a33329}.success{color:#176e54}.spaced{margin-top:20rpx}
