.pdf-page button{width:100%;max-width:none}.pdf-page .choose-photo{margin:32rpx 0;padding:36rpx 16rpx;background:#fff;border:2rpx dashed #9cb7a4;border-radius:32rpx;color:#176e54}.pick-symbol{font-size:48rpx;font-weight:400}.section-label{font-size:30rpx;font-weight:600}.image-row{display:flex;align-items:center;gap:18rpx;background:#fff;border:1rpx solid #e0e9e2;border-radius:24rpx;padding:22rpx;margin:16rpx 0}.page-number{font-size:24rpx;width:24rpx;color:#688277;flex-shrink:0}.thumbnail{width:110rpx;height:130rpx;border-radius:14rpx;flex-shrink:0}.image-details{flex:1;min-width:0}.order-actions{display:flex;gap:10rpx;margin-top:10rpx}.pdf-page .order-button{width:auto;flex:1;min-width:0;font-size:22rpx;color:#176e54;background:#edf4ef;border-radius:12rpx;padding:14rpx 4rpx}.pdf-page .remove{color:#a33329;background:#faf0ed}.page-modes{display:flex;gap:14rpx;margin:24rpx 0}.pdf-page .mode-button{flex:1;width:0;min-width:0;background:#f7faf7;border:2rpx solid #dce7df;border-radius:20rpx;padding:24rpx 8rpx;color:#41644d;font-size:26rpx}.pdf-page .selected{background:#e5f2e9;border-color:#176e54;color:#176e54}.filename-row{display:flex;gap:16rpx;align-items:center;margin-top:22rpx}.filename-row input{flex:1;min-width:0;height:88rpx;padding:16rpx;border:1rpx solid #bacebf;background:#f5f8f5;border-radius:16rpx}.export-note{margin:28rpx 0;line-height:1.8}.file-card{text-align:center;padding:50rpx 28rpx;margin:36rpx 0}.pdf-icon{width:100rpx;height:100rpx}.file-title{font-size:34rpx;font-weight:600;overflow-wrap:anywhere;margin:22rpx 0 12rpx}.notice{color:#754c1d;background:#fff0dc;padding:24rpx;border-radius:18rpx;margin-top:24rpx;overflow-wrap:break-word}.worker-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;pointer-events:none}
