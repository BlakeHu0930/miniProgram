.pick{width:100%;border:2rpx dashed #9cb7a4;background:#fff;color:#176e54;border-radius:32rpx;width:100%;padding:34rpx 20rpx;margin:34rpx 0}.plus{font-size:48rpx;font-weight:400;line-height:1.2;margin-bottom:12rpx}.thumbs{display:flex;flex-wrap:wrap;gap:16rpx}.thumb{width:calc((100% - 32rpx)/3);text-align:center;background:#fff;padding:10rpx;border-radius:18rpx}.thumb image{width:100%;height:150rpx;border-radius:12rpx}.remove{background:none;color:#a33329;font-size:24rpx;padding:16rpx 0;min-height:80rpx}.section-label{font-size:30rpx;font-weight:500}.modes,.sizes{display:flex;gap:12rpx;margin:22rpx 0}.chip{flex:1;background:#fff;border:2rpx solid #dce7df;border-radius:18rpx;color:#41644d;padding:20rpx 10rpx;min-height:88rpx}.selected{background:#e5f2e9;border-color:#176e54;color:#176e54}.custom{display:flex;align-items:center;gap:18rpx}.custom input{flex:1;min-width:0;background:#f5f8f5;border:1rpx solid #bacebf;padding:18rpx;height:88rpx;border-radius:16rpx}.page .advanced{display:flex;align-items:center;justify-content:flex-start;width:100%;max-width:none;margin-left:0;margin-right:0;background:none;color:#486754;text-align:left;padding:14rpx 0;min-height:88rpx}.notice{color:#754c1d;background:#fff0dc;padding:24rpx;border-radius:18rpx;margin-top:24rpx;overflow-wrap:break-word}.privacy{background:none;color:#647a6e;font-size:22rpx;margin-top:30rpx;padding:20rpx 0}.summary{margin:30rpx 0}.value{font-size:66rpx;line-height:1.3;color:#176e54;font-weight:600;margin-bottom:14rpx}.result-thumb{width:122rpx;height:122rpx;border-radius:18rpx;flex-shrink:0}.result-info{flex:1;min-width:0;overflow-wrap:break-word}.output{font-size:34rpx;color:#176e54;margin-top:8rpx}.result-actions{display:flex;gap:16rpx;margin-top:24rpx}.result-actions button{flex:1;font-size:24rpx}.worker-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;pointer-events:none}
