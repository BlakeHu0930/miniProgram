<view class="page">
  <block wx:if="{{stage === 'settings'}}">
    <view class="eyebrow">IMAGE COMPRESSOR</view><view class="headline">轻一点，依然清楚。</view><view class="muted">把照片压到你需要的大小。</view>
    <button class="pick" style="width:100%" bindtap="choose" disabled="{{busy || choosing || items.length >= 9}}" loading="{{choosing}}"><view class="plus">＋</view><view>{{items.length ? '继续添加图片' : '选择图片'}}</view><view class="small muted">{{items.length}}／9 张 · 支持 JPG、PNG</view></button>
    <view wx:if="{{items.length}}" class="thumbs"><view wx:for="{{items}}" wx:key="id" class="thumb"><image src="{{item.path}}" mode="aspectFill" bindtap="preview" data-id="{{item.id}}"/><view class="tiny muted">{{item.sizeText}}</view><button class="remove" bindtap="remove" data-id="{{item.id}}" aria-label="移除图片">移除</button></view></view>
    <view class="panel"><view class="section-label">压缩方式</view><view class="modes"><button class="chip {{mode === 'target' ? 'selected' : ''}}" bindtap="setMode" data-mode="target">指定大小</button><button class="chip {{mode === 'balanced' ? 'selected' : ''}}" bindtap="setMode" data-mode="balanced">均衡压缩</button></view>
      <block wx:if="{{mode === 'target'}}"><view class="small">每张图片的目标大小</view><view class="sizes"><button class="chip {{!useCustom && targetKB === 200 ? 'selected' : ''}}" bindtap="setTarget" data-size="200">200KB</button><button class="chip {{!useCustom && targetKB === 500 ? 'selected' : ''}}" bindtap="setTarget" data-size="500">500KB</button><button class="chip {{!useCustom && targetKB === 1024 ? 'selected' : ''}}" bindtap="setTarget" data-size="1024">1MB</button></view><view class="custom"><text class="small">自定义</text><input type="number" maxlength="6" placeholder="例如 300" value="{{customKB}}" bindinput="customInput" aria-label="自定义目标大小"/><text>KB</text></view><view class="small muted spaced">优先保留清晰度，必要时等比例缩小尺寸。</view></block>
      <view wx:else class="small muted spaced">自动选择适中的画质，尽量保留原始尺寸，不保证特定大小。</view>
    </view>
    <button class="advanced" bindtap="toggleAdvanced">高级设置 {{advanced ? '−' : '＋'}}</button><view wx:if="{{advanced}}" class="panel"><view class="row"><text>允许 PNG 转为白底 JPG</text><switch checked="{{convertJpg}}" bindchange="toggleJpg" color="#176e54"/></view><view class="small muted spaced">默认保留透明背景。PNG 不通过降低画质压缩，必要时会缩小尺寸。</view><view class="small muted spaced">输出最长边 ≤4096 像素、总像素 ≤800 万。1KB＝1024 字节。</view></view>
    <button class="primary spaced" style="width:100%" bindtap="run" disabled="{{!items.length || choosing || busy}}">压缩 {{items.length || ''}} 张图片</button>
  </block>
  <block wx:else>
    <view class="eyebrow">{{busy ? 'PROCESSING' : 'ALL DONE'}}</view><view class="headline">{{busy ? '正在轻装处理…' : '处理结果'}}</view><view class="muted">{{busy ? progress : '成功处理 ' + successCount + ' 张，请查看每张的达标状态。'}}</view>
    <view wx:if="{{!busy && successCount}}" class="summary"><view class="value">{{totalAfter}}</view><view class="row small muted"><text>成功项原始合计 {{totalBefore}}</text><text>减少 {{reduction}}%</text></view></view>
    <view wx:for="{{items}}" wx:key="id" class="panel result"><view class="row"><image class="result-thumb" src="{{item.output ? item.output.path : item.path}}" mode="aspectFill" bindtap="preview" data-id="{{item.id}}"/><view class="result-info"><view>照片 {{index + 1}}</view><view class="small muted">原图 {{item.sizeText}} · {{item.dimensionsText}}</view><block wx:if="{{item.status === 'done'}}"><view class="output">{{item.outputSize}} <text class="small muted">{{item.outputDimensions}}</text></view><view class="small {{item.unmet ? 'error' : 'success'}}">{{item.statusText}}</view></block><view wx:elif="{{item.status === 'failed'}}" class="small error">{{item.error}}</view><view wx:else class="small muted">{{item.status === 'processing' ? '正在处理…' : '等待处理'}}</view></view></view><view wx:if="{{item.output}}" class="result-actions"><button class="secondary" bindtap="preview" data-id="{{item.id}}">预览对比</button><button class="secondary" bindtap="saveOne" data-id="{{item.id}}" disabled="{{busy || saving || item.saved}}">{{item.saved ? '已保存' : '保存图片'}}</button></view></view>
    <block wx:if="{{!busy}}"><button class="primary" style="width:100%" bindtap="saveAll" disabled="{{saving || !successCount}}" loading="{{saving}}">保存尚未保存的图片</button><button class="secondary spaced" bindtap="retry" disabled="{{saving}}">重试失败图片</button><button class="secondary spaced" bindtap="adjust" disabled="{{saving}}">调整参数 / 添加图片</button></block>
  </block>
  <view wx:if="{{notice}}" class="notice" aria-role="alert">{{notice}}</view><button class="privacy" bindtap="privacyInfo">图片本地处理 · 保留原图 · 使用说明</button>
</view>
<canvas type="2d" id="compression-canvas" class="worker-canvas"/>
